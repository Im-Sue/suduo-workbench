    "db:migrate": "node dist/migrate.js",
    "clean": "rm -rf dist tsconfig.tsbuildinfo"
  },
  "dependencies": {
    "@fastify/busboy": "3.2.1",
    "@fastify/jwt": "10.2.1",
    "@suduo/cloud-contracts": "workspace:*",
    "fastify": "5.11.3",
    "pg": "8.23.0"
  },
  "devDependencies": {
    "@types/pg": "8.21.0"
  }
}
