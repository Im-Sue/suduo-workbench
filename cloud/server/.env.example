# 必填：服务启动前必须提供。Compose 会用 POSTGRES_* 覆盖下面的数据库 URL；
# 独立运行时则使用本行，请使其与实际 PostgreSQL 凭据保持一致。
REQUIREMENTS_DATABASE_URL=postgresql://suduo:replace-this-postgres-password@postgres:5432/suduo_requirements
# 必须替换为至少 32 个随机字符；例如：openssl rand -base64 48
REQUIREMENTS_AUTH_SECRET=replace-this-with-a-random-secret-of-at-least-32-characters
# 必须是绝对路径；compose 中由 requirements_attachments 具名卷挂载到此路径。
REQUIREMENTS_ATTACHMENT_ROOT=/var/lib/suduo/attachments
# 房间文件（聊天里的图片 / 文件 / 视频）根目录：绝对路径、SuDuo 独占，不能与附件根目录相同或互相嵌套。
# 未设置时缺省为 <REQUIREMENTS_ATTACHMENT_ROOT>-rooms；compose 中由 requirements_room_files 具名卷挂载到此路径。
REQUIREMENTS_ROOM_FILE_ROOT=/var/lib/suduo/room-files

# 可选：未设置时使用下列真实默认值。
# 默认：8h（允许 60 秒至 30 天，例如 30m、8h、7d）
REQUIREMENTS_AUTH_TTL=8h
# 默认：suduo-requirements-service
REQUIREMENTS_AUTH_ISSUER=suduo-requirements-service
# 默认：suduo-local-bff
REQUIREMENTS_AUTH_AUDIENCE=suduo-local-bff
# 默认：10（范围 2–100）
REQUIREMENTS_DATABASE_POOL_MAX=10
# 默认：5000（毫秒，范围 100–60000）
REQUIREMENTS_DATABASE_CONNECTION_TIMEOUT_MS=5000
# 默认：0.0.0.0
REQUIREMENTS_HOST=0.0.0.0
# 默认：4100
REQUIREMENTS_PORT=4100
# 默认：true
REQUIREMENTS_LOGGER=true
# 默认：true；生产部署保留 true，以便启动时执行 migration。
REQUIREMENTS_RUN_MIGRATIONS=true
# 默认且唯一允许值：314572800（300 MiB）
REQUIREMENTS_MAX_ATTACHMENT_BYTES=314572800
# 默认且唯一允许值：20
REQUIREMENTS_MAX_ATTACHMENTS_PER_REQUIREMENT=20
# 默认：.pdf,.doc,.docx,.xls,.xlsx,.ppt,.pptx,.txt,.md,.csv,.json,.xml,.png,.jpg,.jpeg,.gif,.webp,.zip,.html,.htm,.svg
REQUIREMENTS_ALLOWED_ATTACHMENT_EXTENSIONS=.pdf,.doc,.docx,.xls,.xlsx,.ppt,.pptx,.txt,.md,.csv,.json,.xml,.png,.jpg,.jpeg,.gif,.webp,.zip,.html,.htm,.svg
# 房间文件允许的扩展名（单个文件上限同附件 300 MiB）。
# 默认：.png,.jpg,.jpeg,.gif,.webp,.bmp,.avif,.heic,.svg,.mp4,.m4v,.mov,.webm,.pdf,.doc,.docx,.xls,.xlsx,.ppt,.pptx,.txt,.log,.md,.csv,.json,.yaml,.yml,.xml,.html,.htm,.zip,.rar,.7z,.tar,.gz,.tgz
# REQUIREMENTS_ALLOWED_ROOM_FILE_EXTENSIONS=

# 仅供 compose 初始化 PostgreSQL；不是 requirements-service 读取的环境变量。
POSTGRES_DB=suduo_requirements
POSTGRES_USER=suduo
POSTGRES_PASSWORD=replace-this-postgres-password

# 可选：构建与镜像来源。国内服务器可用 ./scripts/suduo-cloud.sh install --mirror cn 自动写入，也可手动修改。
# SUDUO_NODE_IMAGE=node:24.10.0-bookworm-slim
# SUDUO_POSTGRES_IMAGE=postgres:17.4-bookworm
# SUDUO_NPM_REGISTRY=https://registry.npmjs.org
