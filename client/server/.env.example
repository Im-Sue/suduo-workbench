SUDUO_HOST=127.0.0.1
SUDUO_PORT=8787
SUDUO_DATA_DIR=
SUDUO_DB_PATH=
# 可选：团队云端（需求服务）根地址；未设置时在「设置 → 需求服务」里配置。
SUDUO_REQUIREMENTS_SERVICE_URL=
# 可选：云端登录态、已选地址与需求材料目录；默认 <SUDUO_DATA_DIR>/requirements-v2。
SUDUO_V2_DATA_DIR=
# Codex 的配置目录：SUDUO_CODEX_HOME 优先，其次 CODEX_HOME，都没设置时用 ~/.codex（不存在时自动创建）。
SUDUO_CODEX_BIN=codex
SUDUO_CODEX_HOME=
SUDUO_CODEX_VERSION=0.159.2
SUDUO_CODEX_TRANSPORT=stdio
SUDUO_SSE_HEARTBEAT_MS=15000
SUDUO_SSE_REPLAY_PAGE_SIZE=500
SUDUO_RUNTIME_RESTART_MAX_MS=30000
SUDUO_FS_WATCH_DEBOUNCE_MS=300
SUDUO_FS_POLL_INTERVAL_MS=2000
# Windows/跨盘 watcher 异常时可强制轮询。
SUDUO_FS_FORCE_POLLING=false
SUDUO_LOG_LEVEL=info
